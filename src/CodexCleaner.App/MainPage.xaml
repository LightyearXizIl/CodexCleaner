<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CodexCleaner.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="28,12,28,8" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource BrandBrush}">
                    <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Codex Cleaner" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="38" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="NavDashboard" Style="{StaticResource PillButtonStyle}" Tag="Dashboard" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE80F;"/><TextBlock Text="概览" Foreground="{StaticResource InkBrush}"/></StackPanel></Button>
                        <Button x:Name="NavCodex" Style="{StaticResource PillButtonStyle}" Tag="CodexUsage" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FD;"/><TextBlock Text="Codex 任务" Foreground="{StaticResource InkBrush}"/></StackPanel></Button>
                        <Button x:Name="NavReleaseSpace" Style="{StaticResource PillButtonStyle}" Tag="Cleanup" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B0;"/><TextBlock Text="释放空间" Foreground="{StaticResource InkBrush}"/></StackPanel></Button>
                        <Button x:Name="NavDeveloper" Style="{StaticResource PillButtonStyle}" Tag="Developer" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE950;"/><TextBlock Text="开发环境" Foreground="{StaticResource InkBrush}"/></StackPanel></Button>
                        <Button x:Name="NavSpaceChanges" Style="{StaticResource PillButtonStyle}" Tag="SpaceChanges" Click="Navigate_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D2;"/><TextBlock Text="空间分析" Foreground="{StaticResource InkBrush}"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button Width="44" Height="44" CornerRadius="22" Foreground="{StaticResource InkBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" Click="Search_Click"><FontIcon Glyph="&#xE721;" /></Button>
                <Button Width="44" Height="44" CornerRadius="22" Foreground="{StaticResource InkBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" Tag="Settings" Click="Navigate_Click"><FontIcon Glyph="&#xE713;" /></Button>
                <Button Width="44" Height="44" CornerRadius="22" Foreground="{StaticResource InkBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" Tag="History" Click="Navigate_Click"><FontIcon Glyph="&#xE712;" /></Button>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Page>
